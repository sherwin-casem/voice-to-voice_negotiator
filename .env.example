# Application
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/voice_negotiator
DATABASE_ECHO=false

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_WS_URL=ws://localhost:8000
# NEXT_PUBLIC_DEV_USER_ID=00000000-0000-4000-8000-000000000001

# Upload and voice limits
MAX_UPLOAD_BYTES=512000
WS_MAX_AUDIO_CHUNK_BYTES=256000
WS_MAX_TURN_AUDIO_BYTES=5242880

# AI provider
AI_PROVIDER=mock

# OpenAI (required when AI_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_ORGANIZATION=
# OPENAI_BASE_URL=

# Model configuration
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_STRUCTURED_MODEL=gpt-4o-mini
OPENAI_STREAMING_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# AI request behavior
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=0.5

# Auth (JWT)
JWT_SECRET=change-me-in-development-only
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
ALLOW_DEV_USER_HEADER=true

# Reserved for future use (not implemented yet)
